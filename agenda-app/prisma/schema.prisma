generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Agenda {
  id          String       @id @default(cuid())
  title       String
  description String?
  startAt     DateTime?
  timezone    String?
  items       AgendaItem[]
  people      Person[]
  runs        MeetingRun[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Person {
  id        String       @id @default(cuid())
  agendaId  String
  agenda    Agenda       @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  name      String
  // Self-registered via the guest QR code during a meeting; shown as
  // "<name> (Guest)". contact is the phone/email they left (guests only).
  isGuest   Boolean      @default(false)
  contact   String?
  items     AgendaItem[]
  segments  RunSegment[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([agendaId])
}

model AgendaItem {
  id              String   @id @default(cuid())
  agendaId        String
  agenda          Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  personId        String?
  person          Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  title              String
  url                String?
  durationMinutes    Float
  minMinutes         Float?
  maxMinutes         Float?
  subLabel           String?
  subMinMinutes      Float?
  subExpectedMinutes Float?
  subMaxMinutes      Float?
  // Set when the item was picked from a special item list (e.g. a Pathways
  // project): which list, and the chosen value's label.
  specialItemId      String?
  specialItem        SpecialItem? @relation(fields: [specialItemId], references: [id], onDelete: SetNull)
  specialValue       String?
  position           Int
  runSegments        RunSegment[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([agendaId, position])
  @@index([personId])
  @@index([specialItemId])
}

// A predefined list of values with times (e.g. Pathways projects) that agenda
// items can be picked from. Values are stored as CSV like templates; see
// src/lib/special-item-csv.ts for the format.
model SpecialItem {
  id          String       @id @default(cuid())
  name        String
  csv         String
  agendaItems AgendaItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  name      String
  csv       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingRun {
  id        String       @id @default(cuid())
  agendaId  String
  agenda    Agenda       @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  startedAt DateTime     @default(now())
  endedAt   DateTime?
  // Display mode forced onto every viewer of /run from the control page:
  // 'standard' | 'focus' | 'report'. Null means unenforced — each display
  // follows its own locally-remembered preference.
  enforcedDisplayMode String?
  segments  RunSegment[]

  @@index([agendaId])
}

model RunSegment {
  id              String      @id @default(cuid())
  runId           String
  run             MeetingRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId          String?
  item            AgendaItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  kind            String // 'item' (the item itself / intro) | 'sub' (one participant)
  subIndex        Int? // 1-based participant number when kind='sub'
  personId        String? // participant assigned to this segment (e.g. who speaker 2 was)
  person          Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  label           String // snapshot: item title, or "<subLabel|Sub-item> <n>"
  comment         String? // free-text note typed on the control page, shown in the report
  minMinutes      Float? // threshold snapshots taken at segment creation
  expectedMinutes Float?
  maxMinutes      Float?
  position        Int // order within the run
  startedAt       DateTime
  endedAt         DateTime?
  skipped         Boolean   @default(false) // ended via "Skip agenda item"
  itemDone        Boolean   @default(false) // whole item declared finished (no more subs)
  pausedAt        DateTime? // set while the timer is paused
  pausedSeconds   Float     @default(0) // accumulated pause time, excluded from elapsed
  prepStartedAt   DateTime? // when the participant's prep time began (sub-items)
  prepEndedAt     DateTime? // when the participant's prep time ended (sub-items)

  @@index([runId, position])
}
